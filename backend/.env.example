# Backend environment — copy to backend/.env and fill in real values.
NODE_ENV=development
PORT=4000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ratesphere
DB_POOL_SIZE=10

# Generate a long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:8080
